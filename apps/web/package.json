{
  "name": "@os-community/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --turbo",
    "build": "npm run i18n:build -w @os-community/shared && next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "next lint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:academy": "vitest run src/lib/academy",
    "test:e2e": "playwright test",
    "test:e2e:resilience": "playwright test e2e/resilience.spec.ts",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.9.1",
    "@os-community/academy-client": "*",
    "@os-community/db": "*",
    "@os-community/shared": "*",
    "gray-matter": "^4.0.3",
    "next": "^15.3.3",
    "next-auth": "^5.0.0-beta.31",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.8.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.8",
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "eslint": "^9.28.0",
    "eslint-config-next": "^15.3.3",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3",
    "vitest": "^3.0.8",
    "@playwright/test": "^1.52.0",
    "zod": "^3.24.2"
  }
}
