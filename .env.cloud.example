# southwood.cloud SaaS stack — copy to .env.cloud
#   cp .env.cloud.example .env.cloud

CLOUD_DOMAIN=southwood.cloud

# Local Caddy ports (Cloudflare Tunnel → CLOUD_HTTPS_PORT)
CLOUD_HTTPS_PORT=8443
CLOUD_HTTP_PORT=8088

# Control Plane DB
CP_POSTGRES_USER=southwood_cloud
CP_POSTGRES_PASSWORD=southwood_cloud_dev_change_me
CP_POSTGRES_DB=southwood_cloud

# Org Agent auth (Mac mini ↔ control.southwood.cloud)
AGENT_TOKEN=dev-agent-token-change-me

# Dev profile: demo org slug for {org-slug}.southwood.cloud
ORG_SLUG=demo
AGENT_VERSION=0.1.0-skeleton

# Cloudflare Tunnel (southwood.cloud — separate ID from southwood.inc)
CLOUDFLARE_TUNNEL_ID=

# Phase 2 auth (not wired in skeleton yet)
# AUTH_SECRET=
# AUTH_URL=https://dash.southwood.cloud
