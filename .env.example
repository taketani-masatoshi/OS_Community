# Database
DATABASE_URL=postgresql://oscommunity:oscommunity@localhost:5432/oscommunity

# Docker dev only — run `npm run push -w @os-community/db` on container start (schema drift recovery).
# RUN_DB_PUSH=1

# Auth.js — GitHub OAuth App: https://github.com/settings/developers
# Callback: https://community.oorgos.org/api/auth/callback/github
AUTH_SECRET=generate-with-openssl-rand-base64-32
# JWT claim refresh interval (ms). Default 300000 (5 minutes).
# AUTH_CLAIMS_REFRESH_MS=300000

# URL profile — pick ONE profile and keep AUTH_URL aligned with how you open the site:
#   Local npm run dev:     AUTH_URL=http://localhost:3000  NEXT_PUBLIC_SITE_URL=http://localhost:3000
#   Docker + Caddy/Tunnel: AUTH_URL=https://openorgos.net  NEXT_PUBLIC_SITE_URL=https://openorgos.net
#   oorgos.org subdomain:  AUTH_URL=https://community.oorgos.org  NEXT_PUBLIC_SITE_URL=https://community.oorgos.org
#                          DOMAIN=community.oorgos.org  — see docs/oorgos-subdomain-setup.md
# npm run dev / dev:start override AUTH_URL to http://localhost:3000 automatically.
AUTH_URL=https://community.oorgos.org
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# GitHub App (Phase B — auto-provision repo permissions on steward-os org)
# Create at https://github.com/settings/apps/new
# Webhook URL: https://community.oorgos.org/api/github/webhook
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_SLUG=steward-os-community
GITHUB_APP_ORG=steward-os
# Optional: skip lookup when multiple installations exist
GITHUB_APP_INSTALLATION_ID=

# Optional PAT for public API rate limits (tags, repo existence checks)
GITHUB_TOKEN=

# OpenOrgOS login — Google OAuth: https://console.cloud.google.com/
# Callback: https://community.oorgos.org/api/auth/callback/google
# Local dev callback: http://localhost:3000/api/auth/callback/google
# Setup: npm run auth:primary:setup  ·  Docs: docs/google-oauth-setup.md
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# LinkedIn — https://www.linkedin.com/developers/
# Callback: https://community.oorgos.org/api/auth/callback/linkedin
# Local dev callback: http://localhost:3000/api/auth/callback/linkedin
# Setup: npm run auth:linkedin:setup  ·  Docs: docs/linkedin-oauth-setup.md
AUTH_LINKEDIN_ID=
AUTH_LINKEDIN_SECRET=

# App
NEXT_PUBLIC_SITE_URL=https://community.oorgos.org
CONTENT_ROOT=
STEWARD_REPO_PATH=/Users/kk/OS_Steward
# CI / protocol sync scripts (sibling checkout or vars.STEWARD_REPO → orgos-steward/)
STEWARD_ORGOS_ROOT=/Users/kk/OS_Steward
# Steward protocol API (wire node governance BFF proxy)
STEWARD_API_URL=http://127.0.0.1:8799
# OrgOS Steward protocol API for tenant-mail Gmail bind (falls back to STEWARD_API_URL)
ORGOS_STEWARD_PROTOCOL_URL=http://127.0.0.1:9476
ORGOS_COMMUNITY_GOVERNANCE_TOKEN=

# OrgOS mail Gmail connect (Community → Steward token push)
# Can reuse AUTH_GOOGLE_* when the same Google OAuth client is used.
# Add redirect URI: {AUTH_URL}/api/integrations/orgos-mail/callback
ORGOS_GMAIL_CLIENT_ID=
ORGOS_GMAIL_CLIENT_SECRET=
# Tenant-mail connect UI/API — off until CEO ship gate (ADR 0004 · OS_Steward)
# COMMUNITY_TENANT_MAIL_CONNECT_SHIPPED=1
# E2E / local demo without Steward HTTP — in-memory mock store
WIRE_NODE_MOCK=0

# Academy (OS_Content Content API)
# Host machine: http://127.0.0.1:8787
# docker-compose.dev.yml: http://academy-api:8787 (inside compose network)
ACADEMY_API_URL=http://127.0.0.1:8787
ACADEMY_API_TIMEOUT_MS=10000
ACADEMY_INTERNAL_TOKEN=dev-internal-token
ACADEMY_CURRICULUM_VERSION=2026.06.0
ACADEMY_EXAM_MAX_ATTEMPTS=3
ACADEMY_EXAM_COOLDOWN_HOURS=24

# Production (docker-compose.prod.yml)
DOMAIN=community.oorgos.org
COMMUNITY_TUNNEL_ID=

# Rate limiting — optional Upstash Redis REST for distributed counters (multi-instance)
# See docs/production-rate-limiting.md
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# RATE_LIMIT_DISABLED=1  # local / e2e only

# Beta release channel (see docs/beta-operations.md)
# APP_VERSION=0.1.0-beta.1
# APP_CHANNEL=beta
# OPENORGOS_CHANNEL_URL=https://raw.githubusercontent.com/taketani-masatoshi/OS_Community/main/channel/latest.json
# IMAGE_TAG=beta
# WEB_IMAGE=ghcr.io/taketani-masatoshi/os-community-web
# POSTGRES_PASSWORD=  # required for docker-compose.release.yml
